# Copy to `.env.local` and fill in from Supabase → Project Settings → API

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (new projects) or the legacy anon key — both are public and
# safe to expose to the browser; row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
